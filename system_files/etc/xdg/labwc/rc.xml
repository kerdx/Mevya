<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <!-- Reuse the monitor's current mode to minimize startup flicker. -->
    <reuseOutputMode>yes</reuseOutputMode>
    <!-- Keep XWayland available for legacy desktop applications. -->
    <xwaylandPersistence>yes</xwaylandPersistence>
  </core>

  <desktops number="2" />

  <!-- Lightweight manual tiling. Regions are calculated per output's usable
       area, so the same shortcuts work on a laptop, an external monitor, or
       a future dock without hard-coded monitor names. -->
  <regions>
    <region name="mevya-half-left" x="0%" y="0%" width="50%" height="100%" />
    <region name="mevya-half-right" x="50%" y="0%" width="50%" height="100%" />

    <region name="mevya-third-left" x="0%" y="0%" width="33.333%" height="100%" />
    <region name="mevya-third-center" x="33.333%" y="0%" width="33.334%" height="100%" />
    <region name="mevya-third-right" x="66.667%" y="0%" width="33.333%" height="100%" />

    <region name="mevya-quarter-top-left" x="0%" y="0%" width="50%" height="50%" />
    <region name="mevya-quarter-top-right" x="50%" y="0%" width="50%" height="50%" />
    <region name="mevya-quarter-bottom-left" x="0%" y="50%" width="50%" height="50%" />
    <region name="mevya-quarter-bottom-right" x="50%" y="50%" width="50%" height="50%" />
  </regions>

  <!-- Super+Up should produce a top half instead of maximizing the window. -->
  <snapping>
    <topMaximize>no</topMaximize>
    <notifyClient>region</notifyClient>
    <overlay>
      <enabled>yes</enabled>
    </overlay>
  </snapping>

  <!-- DMS draws its own frame and close button. Avoid a second labwc titlebar
       around DMS settings and other framed shell windows. Keep compatibility
       with the app-id used by older DMS releases. -->
  <windowRules>
    <windowRule identifier="com.danklinux.dms" serverDecoration="no" />
    <windowRule identifier="org.danklinux.dms" serverDecoration="no" />

    <!-- Native fixed-size Wayland windows are reported as dialogs by labwc;
         center them so installer/settings/authentication dialogs do not open
         partly outside the active monitor. -->
    <windowRule type="dialog">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <windowRule type="utility">
      <action name="AutoPlace" policy="center" />
    </windowRule>

    <!-- Firefox Picture-in-Picture is a utility window: keep it visible over
         normal applications while still allowing the user to move it. -->
    <windowRule identifier="firefox*" title="*picture-in-picture*">
      <action name="AutoPlace" policy="center" />
      <action name="ToggleAlwaysOnTop" />
    </windowRule>
  </windowRules>

  <theme>
    <!-- Material-compatible geometry; colors come from themerc-override. -->
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>12</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <font place="ActiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <slant>normal</slant>
      <weight>normal</weight>
    </font>
    <font place="InactiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <slant>normal</slant>
      <weight>normal</weight>
    </font>
  </theme>

  <keyboard>
    <default />

    <keybind key="W-Return">
      <action name="Execute">
        <command>ptyxis --new-window</command>
      </action>
    </keybind>

    <keybind key="W-space">
      <action name="Execute">
        <command>dms ipc call spotlight toggle</command>
      </action>
    </keybind>

    <keybind key="W-v">
      <action name="Execute">
        <command>dms ipc call clipboard toggle</command>
      </action>
    </keybind>

    <keybind key="W-m">
      <action name="Execute">
        <command>dms ipc call processlist focusOrToggle</command>
      </action>
    </keybind>

    <keybind key="W-comma">
      <action name="Execute">
        <command>dms ipc call settings focusOrToggle</command>
      </action>
    </keybind>

    <keybind key="W-l">
      <action name="Execute">
        <command>dms ipc call lock lock</command>
      </action>
    </keybind>

    <!-- Manual 50/50 tiling. Repeating the same shortcut restores the
         previous floating geometry through ToggleSnapToEdge. -->
    <keybind key="W-Left">
      <action name="ToggleSnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="ToggleSnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleSnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-Down">
      <action name="ToggleSnapToEdge" direction="down" />
    </keybind>

    <!-- Move a window as a floating client to the corresponding screen edge. -->
    <keybind key="W-S-Left">
      <action name="UnSnap" />
      <action name="MoveToEdge" direction="left" snapWindows="no" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="UnSnap" />
      <action name="MoveToEdge" direction="right" snapWindows="no" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="UnSnap" />
      <action name="MoveToEdge" direction="up" snapWindows="no" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="UnSnap" />
      <action name="MoveToEdge" direction="down" snapWindows="no" />
    </keybind>

    <!-- Super+U is the explicit escape hatch back to floating mode. -->
    <keybind key="W-u">
      <action name="UnSnap" />
    </keybind>

    <!-- Super+Ctrl+1..3: thirds; Super+Ctrl+4..7: quadrants. -->
    <keybind key="W-C-1">
      <action name="ToggleSnapToRegion" region="mevya-third-left" />
    </keybind>
    <keybind key="W-C-2">
      <action name="ToggleSnapToRegion" region="mevya-third-center" />
    </keybind>
    <keybind key="W-C-3">
      <action name="ToggleSnapToRegion" region="mevya-third-right" />
    </keybind>
    <keybind key="W-C-4">
      <action name="ToggleSnapToRegion" region="mevya-quarter-top-left" />
    </keybind>
    <keybind key="W-C-5">
      <action name="ToggleSnapToRegion" region="mevya-quarter-top-right" />
    </keybind>
    <keybind key="W-C-6">
      <action name="ToggleSnapToRegion" region="mevya-quarter-bottom-left" />
    </keybind>
    <keybind key="W-C-7">
      <action name="ToggleSnapToRegion" region="mevya-quarter-bottom-right" />
    </keybind>

    <!-- Keep labwc's two global workspaces aligned with DMS/ext-workspace. -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="yes" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="yes" />
    </keybind>

    <keybind key="W-p">
      <action name="Execute">
        <command>dms ipc call powerprofile toggle</command>
      </action>
    </keybind>

    <keybind key="W-i">
      <action name="Execute">
        <command>dms ipc call inhibit toggle</command>
      </action>
    </keybind>

    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>dms ipc call brightness increment 5</command>
      </action>
    </keybind>

    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>dms ipc call brightness decrement 5</command>
      </action>
    </keybind>

    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>dms ipc call mic mute</command>
      </action>
    </keybind>

    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>dms ipc call audio increment 5</command>
      </action>
    </keybind>

    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>dms ipc call audio decrement 5</command>
      </action>
    </keybind>

    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>dms ipc call audio mute</command>
      </action>
    </keybind>
  </keyboard>
</labwc_config>
