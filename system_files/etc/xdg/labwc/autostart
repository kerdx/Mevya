#!/bin/sh

# Make the complete Wayland/D-Bus session environment available to user services.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all || true
fi

# Enable VirtualBox host/guest clipboard integration when the image is
# running inside VirtualBox. The command is harmless on other hypervisors.
if command -v VBoxClient >/dev/null 2>&1; then
    VBoxClient --clipboard >/dev/null 2>&1 &
fi

# The live `mevya` user is created before /etc/skel is populated by the image
# post-install step. Seed DMS' theme/Matugen profile without overwriting any
# settings the user may already have changed. DMS then keeps GTK and Qt in
# sync with its light/dark mode through the desktop portal.
dms_config_dir="$HOME/.config/DankMaterialShell"
if [ ! -f "${dms_config_dir}/settings.json" ] \
    && [ -f /etc/skel/.config/DankMaterialShell/settings.json ]; then
    mkdir -p "${dms_config_dir}"
    cp /etc/skel/.config/DankMaterialShell/settings.json "${dms_config_dir}/settings.json"
fi
if [ ! -f "${dms_config_dir}/clsettings.json" ] \
    && [ -f /etc/skel/.config/DankMaterialShell/clsettings.json ]; then
    mkdir -p "${dms_config_dir}"
    cp /etc/skel/.config/DankMaterialShell/clsettings.json "${dms_config_dir}/clsettings.json"
fi

matugen_config_dir="$HOME/.config/matugen"
if [ ! -d "${matugen_config_dir}" ] \
    && [ -d /etc/skel/.config/matugen ]; then
    mkdir -p "$(dirname "${matugen_config_dir}")"
    cp -R /etc/skel/.config/matugen "${matugen_config_dir}"
fi

# Initialize the first session in dark mode. DMS then owns future light/dark
# changes; the marker prevents this default from overriding a user's choice.
theme_marker="${dms_config_dir}/.mevya-theme-initialized"
if [ ! -e "${theme_marker}" ] && command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' \
        >/dev/null 2>&1 || true
    gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' \
        >/dev/null 2>&1 || true
fi

# Seed XDG file-manager defaults for users created before the image defaults
# were installed, without overwriting personal associations.
user_mimeapps_file="$HOME/.config/mimeapps.list"
if [ ! -f "${user_mimeapps_file}" ] && [ -f /etc/xdg/mimeapps.list ]; then
    mkdir -p "$(dirname "${user_mimeapps_file}")"
    cp /etc/xdg/mimeapps.list "${user_mimeapps_file}"
fi

# Make the Material Ptyxis palette available to the live user as well as to
# users created from /etc/skel. The dconf profile selects it by name.
ptyxis_palette_dir="$HOME/.local/share/org.gnome.Ptyxis/palettes"
if [ ! -f "${ptyxis_palette_dir}/mevya-material.palette" ] \
    && [ -f /usr/share/org.gnome.Ptyxis/palettes/mevya-material.palette ]; then
    mkdir -p "${ptyxis_palette_dir}"
    cp /usr/share/org.gnome.Ptyxis/palettes/mevya-material.palette \
        "${ptyxis_palette_dir}/mevya-material.palette"
fi

# greetd's initial_session starts labwc directly, so activate the standard
# user-session target before starting services that require it (including DMS).
systemctl --user start graphical-session.target || true

# DMS is the desktop shell: bar, launcher, notifications and system UI.
# Prefer the packaged user service so failures and restarts are visible in the
# user journal; use a managed fallback for older or broken DMS packages.
DMS_STARTED=0
if systemctl --user cat dms.service >/dev/null 2>&1 \
    && systemctl --user start dms.service; then
    DMS_STARTED=1
    systemctl --user start dms-clipboard.service || true
fi

if [ "${DMS_STARTED}" -eq 0 ]; then
    printf '%s\n' 'DMS service non avviato; uso il fallback gestito.' \
        | systemd-cat -t mevya-session
    systemctl --user start mevya-dms-fallback.service
fi

# Synchronize DMS' initial mode with the GTK defaults exactly once. The
# official IPC command also regenerates GTK4/libadwaita theme files and sends
# the portal color-scheme update to applications started afterwards.
if [ ! -e "${theme_marker}" ] && [ "${DMS_STARTED}" -eq 1 ] \
    && dms ipc call theme dark >/dev/null 2>&1; then
    : > "${theme_marker}"
fi

# Apply personal monitor/dock profiles through a restartable user service only
# when the user has configured Kanshi. Its output is kept in journald.
if command -v kanshi >/dev/null 2>&1 \
    && [ -f "$HOME/.config/kanshi/config" ]; then
    systemctl --user start mevya-kanshi.service
fi
