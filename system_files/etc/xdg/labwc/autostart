#!/bin/sh

# Make the complete Wayland/D-Bus session environment available to user services.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all || true
fi

# greetd's initial_session starts labwc directly, so activate the standard
# user-session target before starting services that require it (including DMS).
systemctl --user start graphical-session.target || true

# DMS is the desktop shell: bar, launcher, notifications and system UI.
# Prefer the packaged user service so failures and restarts are visible in the
# user journal; use a managed fallback for older or broken DMS packages.
DMS_STARTED=0
if systemctl --user cat dms.service >/dev/null 2>&1 \
    && systemctl --user start dms.service; then
    DMS_STARTED=1
    systemctl --user start dms-clipboard.service || true
fi

if [ "${DMS_STARTED}" -eq 0 ]; then
    printf '%s\n' 'DMS service non avviato; uso il fallback gestito.' \
        | systemd-cat -t mevya-session
    systemctl --user start mevya-dms-fallback.service
fi

# Apply personal monitor/dock profiles through a restartable user service only
# when the user has configured Kanshi. Its output is kept in journald.
if command -v kanshi >/dev/null 2>&1 \
    && [ -f "$HOME/.config/kanshi/config" ]; then
    systemctl --user start mevya-kanshi.service
fi
