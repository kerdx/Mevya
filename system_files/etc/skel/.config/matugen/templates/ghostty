# Generated by Matugen from the active DMS Material palette.
font-family = JetBrains Mono
font-size = 11

background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}
cursor-style = bar
cursor-style-blink = false
selection-background = {{colors.secondary_container.default.hex}}
selection-foreground = {{colors.on_secondary_container.default.hex}}

palette = 0={{colors.surface_container_high.default.hex}}
palette = 1={{colors.error.default.hex}}
palette = 2={{colors.tertiary.default.hex}}
palette = 3={{colors.secondary.default.hex}}
palette = 4={{colors.primary.default.hex}}
palette = 5={{colors.secondary_container.default.hex}}
palette = 6={{colors.tertiary_container.default.hex}}
palette = 7={{colors.on_surface.default.hex}}
palette = 8={{colors.outline.default.hex}}
palette = 9={{colors.error.default.hex}}
palette = 10={{colors.tertiary.default.hex}}
palette = 11={{colors.secondary.default.hex}}
palette = 12={{colors.primary.default.hex}}
palette = 13={{colors.secondary_container.default.hex}}
palette = 14={{colors.tertiary_container.default.hex}}
palette = 15={{colors.on_surface.default.hex}}
palette-generate = true

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
window-decoration = none
gtk-titlebar = false
unfocused-split-opacity = 0.78
split-divider-color = {{colors.outline_variant.default.hex}}

shell-integration = bash
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo
scrollback-limit = 10000
copy-on-select = false
right-click-action = copy-or-paste
mouse-hide-while-typing = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+f=toggle_fullscreen
