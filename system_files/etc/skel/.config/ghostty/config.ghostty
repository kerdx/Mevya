# Mevya Material theme for Ghostty.
# Matugen updates these colors when the DMS Material palette changes.

font-family = JetBrains Mono
font-size = 11

background = #141218
foreground = #E6E0E9
cursor-color = #D0BCFF
cursor-text = #211F26
cursor-style = bar
cursor-style-blink = false
selection-background = #4F4658
selection-foreground = #E6E0E9

palette = 0=#141218
palette = 1=#F2B8B5
palette = 2=#C4EED0
palette = 3=#E8DEF8
palette = 4=#D0BCFF
palette = 5=#EFB8C8
palette = 6=#B8D8F0
palette = 7=#E6E0E9
palette = 8=#938F99
palette = 9=#F2B8B5
palette = 10=#C4EED0
palette = 11=#E8DEF8
palette = 12=#D0BCFF
palette = 13=#EFB8C8
palette = 14=#B8D8F0
palette = 15=#FFFFFF
palette-generate = true

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
window-decoration = none
gtk-titlebar = false
unfocused-split-opacity = 0.78
split-divider-color = #49454F

shell-integration = bash
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo
scrollback-limit = 10000
copy-on-select = false
right-click-action = copy-or-paste
mouse-hide-while-typing = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+f=toggle_fullscreen
