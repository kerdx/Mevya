#!/bin/sh

set -eu

# Anaconda writes the selected language and LC_* values to /etc/locale.conf.
# Export them before starting D-Bus so labwc, DMS, GTK, Qt and their child
# applications all inherit the same locale.
if [ -r /etc/locale.conf ]; then
    set -a
    . /etc/locale.conf
    set +a
fi

# Create the standard user directories (Documents, Downloads, and others)
# using the locale selected by Anaconda before starting the desktop session.
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
    if ! xdg-user-dirs-update; then
        printf '%s\n' 'Warning: unable to create standard user directories.' >&2
    fi
fi

# Anaconda writes the selected keyboard to the installed XKB/vconsole
# configuration. Prefer the XKB file because it can preserve layout options;
# fall back to the vconsole keymap used by the live image.
xkb_layout=''
xkb_options=''
if [ -r /etc/X11/xorg.conf.d/00-keyboard.conf ]; then
    xkb_layout=$(sed -n 's/.*Option[[:space:]]*"XkbLayout"[[:space:]]*"\([^"]*\)".*/\1/p' \
        /etc/X11/xorg.conf.d/00-keyboard.conf | head -n 1)
    xkb_options=$(sed -n 's/.*Option[[:space:]]*"XkbOptions"[[:space:]]*"\([^"]*\)".*/\1/p' \
        /etc/X11/xorg.conf.d/00-keyboard.conf | head -n 1)
fi
if [ -z "${xkb_layout}" ] && [ -r /etc/vconsole.conf ]; then
    xkb_layout=$(sed -n 's/^KEYMAP[[:space:]]*=[[:space:]]*//p' /etc/vconsole.conf \
        | head -n 1 | tr -d '"' | sed 's/[.]UTF-8$//')
fi
if [ -n "${xkb_layout}" ]; then
    export XKB_DEFAULT_LAYOUT="${xkb_layout}"
fi
if [ -n "${xkb_options}" ]; then
    export XKB_DEFAULT_OPTIONS="${xkb_options}"
fi

exec dbus-run-session -- /usr/bin/labwc
