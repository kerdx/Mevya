#!/bin/sh

set -eu

# Keep the third-party plugin reproducible until it receives a native Mevya
# package. The commit is reviewed manually before changing it.
plugin_id=dankSoftwareDepot
plugin_commit=4f91ced1bafdc8e9a89b36eeda72c0c242adbdb0
plugin_url="https://github.com/vinceecniv/DankSoftwareDepot/archive/${plugin_commit}.tar.gz"

log() {
    printf '%s\n' "mevya-dank-software-depot: $*"
    logger -t mevya-dank-software-depot -- "$*" 2>/dev/null || true
}

if ! command -v curl >/dev/null 2>&1; then
    log 'curl is not installed'
    exit 1
fi

tmpdir=$(mktemp -d /tmp/mevya-dank-software-depot.XXXXXX)
trap 'rm -rf "${tmpdir}"' EXIT INT TERM

archive="${tmpdir}/plugin.tar.gz"
if ! curl --fail --silent --show-error --location \
    --retry 2 --retry-delay 2 --connect-timeout 10 --max-time 90 \
    "${plugin_url}" --output "${archive}"; then
    log "download failed for commit ${plugin_commit}"
    exit 1
fi

if ! tar -xzf "${archive}" -C "${tmpdir}"; then
    log 'downloaded archive could not be extracted'
    exit 1
fi

plugin_source="${tmpdir}/DankSoftwareDepot-${plugin_commit}"
manifest="${plugin_source}/plugin.json"
if [ ! -f "${manifest}" ] || ! grep -Eq '"id"[[:space:]]*:[[:space:]]*"dankSoftwareDepot"' "${manifest}"; then
    log 'downloaded archive failed plugin.json validation'
    exit 1
fi

install_plugin() {
    home_dir="$1"
    owner_uid="$2"
    owner_gid="$3"
    plugin_target="${home_dir}/.config/DankMaterialShell/plugins/${plugin_id}"

    # Preserve a user-managed copy and avoid replacing it on every boot.
    if [ -f "${plugin_target}/plugin.json" ]; then
        return 0
    fi

    install -d -m 0755 "${plugin_target}"
    cp -a "${plugin_source}/." "${plugin_target}/"
    if [ "${home_dir}" != /etc/skel ]; then
        chown -R "${owner_uid}:${owner_gid}" "${plugin_target}"
    fi
}

install_plugin /etc/skel 0 0

# Anaconda creates the technical live user during the compose, while the
# normal user is created later by the installer. Cover both cases.
if command -v getent >/dev/null 2>&1; then
    getent passwd | while IFS=: read -r _ _ uid gid _ home_dir _; do
        case "${uid}" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "${uid}" -ge 1000 ] || continue
        [ -d "${home_dir}" ] || continue
        [ "${home_dir}" != /nonexistent ] || continue
        install_plugin "${home_dir}" "${uid}" "${gid}"
    done
fi

log "installed ${plugin_id} at commit ${plugin_commit}"
