#!/bin/sh

set -eu

# The live image needs the technical `mevya` account for autologin. Anaconda
# creates the real account in the installed system, so switch greetd to that
# account and remove the live-only one on the first installed boot.
if ! id mevya >/dev/null 2>&1; then
    exit 0
fi

installed_user="$(getent passwd \
    | awk -F: '$3 >= 1000 && $3 < 60000 && $1 != "mevya" && $6 ~ /^\/home\// { print $1; exit }')"

if [ -z "${installed_user}" ] || [ "${installed_user}" = "mevya" ]; then
    exit 0
fi

greetd_config=/etc/greetd/config.toml
if [ -f "${greetd_config}" ]; then
    config_tmp="$(mktemp)"
    sed "s/^user = \"mevya\"$/user = \"${installed_user}\"/" \
        "${greetd_config}" > "${config_tmp}"
    install -o root -g root -m 0644 "${config_tmp}" "${greetd_config}"
    rm -f "${config_tmp}"
fi

# The graphical installer belongs only to the live environment.
rm -f /usr/share/applications/mevya-installer.desktop

userdel --remove mevya
