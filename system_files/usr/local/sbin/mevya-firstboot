#!/bin/sh

set -eu

# This service is enabled in both the live image and the installed system.
# Keep the live-only account for greetd autologin, but always clean it up on
# the first boot of the installed system regardless of the chosen user UID.
root_fstype="$(findmnt -n -o FSTYPE / 2>/dev/null || true)"
is_live=0
if [ -e /run/initramfs/live ] || [ -e /run/live/medium ] || [ "${root_fstype}" = "overlay" ]; then
    is_live=1
    logger -t mevya-firstboot 'Live system detected; will configure the live session without removing its account'
fi
# The installed system performs this local migration only once.
state_dir=/var/lib/mevya
complete_marker="${state_dir}/.firstboot-complete"
# These files are needed only by the live session. Remove them before any
# installed-system early exit so the installed image cannot retain a policy
# that grants the technical live account passwordless access to liveinst.
live_installer_desktop=/usr/share/applications/mevya-installer.desktop
live_installer_launcher=/usr/local/bin/mevya-installer
live_installer_polkit_rule=/etc/polkit-1/rules.d/49-mevya-liveinst.rules
if [ "${is_live}" -eq 0 ]; then
    rm -f "${live_installer_desktop}" \
        "${live_installer_launcher}" \
        "${live_installer_polkit_rule}"
    logger -t mevya-firstboot 'Removed live-only installer files and polkit rule'
fi
if [ "${is_live}" -eq 0 ] && [ -e "${complete_marker}" ]; then
    exit 0
fi
# Give users without a personal image a branded default avatar. AccountsService
# keeps a user-selected Icon= entry untouched.
default_avatar=/usr/share/pixmaps/mevya-avatar.svg
accounts_users_dir=/var/lib/AccountsService/users
if [ -f "${default_avatar}" ] && command -v getent >/dev/null 2>&1; then
    install -d -o root -g root -m 0755 "${accounts_users_dir}"
    getent passwd | while IFS=: read -r username _ uid _ _ home_dir _; do
        case "${uid}" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "${uid}" -ge 1000 ] || continue
        [ "${home_dir}" != / ] || continue
        [ "${home_dir}" != /nonexistent ] || continue
        account_file="${accounts_users_dir}/${username}"
        if [ -f "${account_file}" ]; then
            if grep -Eq '^Icon=.+$' "${account_file}"; then
                :
            elif grep -q '^Icon=' "${account_file}"; then
                sed -i "s|^Icon=.*|Icon=${default_avatar}|" "${account_file}"
            else
                printf '%s\n' "Icon=${default_avatar}" >> "${account_file}"
            fi
        else
            temp_account="$(mktemp)"
            printf '[User]\nIcon=%s\n' "${default_avatar}" > "${temp_account}"
            install -o root -g root -m 0644 "${temp_account}" "${account_file}"
            rm -f "${temp_account}"
        fi
    done
fi
if [ "${is_live}" -eq 1 ]; then
    logger -t mevya-firstboot 'Live session setup complete; keeping the live account'
    exit 0
fi
# The live image needs the technical `mevya` account for autologin. On an
# installed system, remove it and leave greetd on its normal login screen.
if ! id mevya >/dev/null 2>&1; then
    install -d -o root -g root -m 0755 "${state_dir}"
    : > "${complete_marker}"
    chmod 0644 "${complete_marker}"
    exit 0
fi

greetd_config=/etc/greetd/config.toml
if [ -f "${greetd_config}" ]; then
    config_tmp="$(mktemp)"
    awk '
        /^\[initial_session\]$/ { skip = 1; next }
        /^\[default_session\]$/ { skip = 0 }
        !skip { print }
    ' "${greetd_config}" > "${config_tmp}"
    install -o root -g root -m 0644 "${config_tmp}" "${greetd_config}"
    rm -f "${config_tmp}"
fi

userdel --remove mevya
install -d -o root -g root -m 0755 "${state_dir}"
: > "${complete_marker}"
chmod 0644 "${complete_marker}"
