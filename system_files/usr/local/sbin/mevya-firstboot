#!/bin/sh

set -eu

# This service is enabled in both the live image and the installed system.
# Keep the live-only account for greetd autologin, but always clean it up on
# the first boot of the installed system regardless of the chosen user UID.
root_fstype="$(findmnt -n -o FSTYPE / 2>/dev/null || true)"
is_live=0
if [ -e /run/initramfs/live ] || [ -e /run/live/medium ] || [ "${root_fstype}" = "overlay" ]; then
    is_live=1
    logger -t mevya-firstboot 'Live system detected; will configure the live session without removing its account'
fi
# The build environment may not have DNS while the image is assembled. Make
# the installed system converge on the intended Flatpak source once networking
# is available, without making first boot fail when the network is still down.
# Install the pinned community DMS plugin for the skeleton and users already
# created by Anaconda. This is best effort: an offline first boot must still
# reach the login screen, and the service can be run again later if needed.
if [ -x /usr/local/sbin/mevya-install-dank-software-depot ]; then
    if timeout 120s /usr/local/sbin/mevya-install-dank-software-depot; then
        logger -t mevya-firstboot 'Dank Software Depot plugin installed'
    else
        logger -t mevya-firstboot 'Dank Software Depot unavailable; retry with /usr/local/sbin/mevya-install-dank-software-depot'
    fi
fi
if command -v flatpak >/dev/null 2>&1; then
    if timeout 30s flatpak remote-add --system --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo; then
        logger -t mevya-firstboot 'Flathub system remote configured'
    else
        logger -t mevya-firstboot 'Flathub unavailable; it can be added later with flatpak remote-add'
    fi
    flatpak remote-delete --system fedora || true
fi
if [ "${is_live}" -eq 1 ]; then
    logger -t mevya-firstboot 'Live session setup complete; keeping the live account'
    exit 0
fi
# The live image needs the technical `mevya` account for autologin. On an
# installed system, remove it and leave greetd on its normal login screen.
if ! id mevya >/dev/null 2>&1; then
    exit 0
fi

greetd_config=/etc/greetd/config.toml
if [ -f "${greetd_config}" ]; then
    config_tmp="$(mktemp)"
    awk '
        /^\[initial_session\]$/ { skip = 1; next }
        /^\[default_session\]$/ { skip = 0 }
        !skip { print }
    ' "${greetd_config}" > "${config_tmp}"
    install -o root -g root -m 0644 "${config_tmp}" "${greetd_config}"
    rm -f "${config_tmp}"
fi

# The graphical installer belongs only to the live environment.
rm -f /usr/share/applications/mevya-installer.desktop

userdel --remove mevya
