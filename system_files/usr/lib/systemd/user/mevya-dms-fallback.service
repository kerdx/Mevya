[Unit]
Description=Mevya DMS compatibility fallback
PartOf=graphical-session.target
After=graphical-session.target
ConditionPathExists=/usr/bin/dms

[Service]
ExecStart=/usr/bin/dms run --session
Environment=DMS_DANKBAR_LAYER=top
Environment=DMS_MODAL_LAYER=overlay
Environment=DMS_POPOUT_LAYER=overlay
Environment=DMS_OSD_LAYER=overlay
Environment=DMS_NOTIFICATION_LAYER=overlay
Environment=DMS_ENABLE_GTK4_REFRESH=1
Environment=DMS_FORCE_EXTWS=1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
