# Base live desktop and graphical installer.
# Keep the live package set explicit: the Fedora 44 base does not expose the
# `minimal-environment` group to livemedia-creator in this repository mix.
anaconda
anaconda-install-env-deps
anaconda-live
glibc-all-langpacks
policycoreutils
wlrctl
dnf5-plugins
dracut-config-generic
kernel
kernel-modules
kernel-modules-extra
livesys-scripts
efibootmgr
grub2
grub2-efi-x64
grub2-efi-x64-cdboot
grub2-tools
shim-x64
greetd
dbus-daemon
labwc
labwc-session

# DankMaterialShell and the Mevya desktop integration.
dms
dms-greeter
quickshell-git
matugen
danksearch
dgop
dankcalendar-git
khal
cava
qt6-qtmultimedia
qt6-qtimageformats
kf6-kimageformats
qt6ct
xdg-terminal-exec
dconf
polkit

# Fonts and input/UI support.
adw-gtk3-theme
material-symbols-fonts
google-noto-emoji-fonts
google-noto-sans-fonts
google-noto-sans-cjk-fonts
jetbrains-mono-fonts
cascadia-code-nf-fonts

# Nautilus and the selected desktop terminal.
nautilus
xdg-user-dirs
nautilus-open-any-terminal
gvfs
gvfs-mtp
gvfs-smb
ptyxis
flatpak-spawn

# Audio, video, camera and hardware acceleration.
pipewire
rtkit
pipewire-alsa
pipewire-pulseaudio
pipewire-utils
wireplumber
alsa-plugins-pulseaudio
# Keep Fedora's -free FFmpeg stack: Anaconda requires the matching
# libavcodec-free libraries, while RPM Fusion's ffmpeg-libs conflicts with it.
ffmpeg-free
libavcodec-freeworld
libcamera-gstreamer
libcamera-tools
fdk-aac-free
gstreamer1-plugins-base
gstreamer1-plugins-base-tools
gstreamer1-plugins-good
gstreamer1-plugins-good-gtk
gstreamer1-plugins-bad-free
gstreamer1-plugins-bad-free-extras
gstreamer1-plugins-ugly
gstreamer1-libav
gstreamer1-plugin-openh264
pipewire-gstreamer
PackageKit-gstreamer-plugin
libva
libva-utils
libva-intel-media-driver
mesa-va-drivers
mesa-va-drivers-freeworld
libvpx
opus
pipewire-codec-aptx
nv-codec-headers
lame
x265
rpmfusion-free-release
rpmfusion-nonfree-release

# Power, networking, printing and desktop hardware support.
power-profiles-daemon
firewalld
chrony
zram-generator-defaults
systemd-oomd-defaults
i2c-tools
iio-sensor-proxy
ddcutil
libinput-utils
powerstat
cups-pk-helper
cups
cups-filters
sane-backends
avahi
bluez
accountsservice
switcheroo-control
lm_sensors
fwupd
linux-firmware

# Display, portals, monitor layout and desktop utilities.
kanshi
wlr-randr
xorg-x11-server-Xwayland
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
wl-clipboard
brightnessctl
grim
slurp
swaybg

# Selected system tools for containers and application distribution.
distrobox
podman
flatpak
ffmpegthumbnailer
virtualbox-guest-additions

# Mevya boot branding.
dracut-live
plymouth
plymouth-plugin-script
