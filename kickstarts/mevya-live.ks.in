# Mevya 44 live image. The renderer injects the package list and the
# selected desktop configuration before livemedia-creator consumes this file.

lang it_IT.UTF-8
keyboard it
timezone Europe/Rome --utc
selinux --enforcing
firewall --enabled
network --bootproto=dhcp --device=link --activate --nameserver=1.1.1.1,8.8.8.8 --hostname=mevya
rootpw --lock
user --name=mevya --groups=wheel --plaintext --password=mevya
services --enabled=NetworkManager,greetd
bootloader --location=none
reqpart
part / --size=16384 --fstype=ext4

# livemedia-creator requires an explicit install method when repo directives
# are present. Fedora Everything supplies the base packages for the live ISO.
url --url=https://download.fedoraproject.org/pub/fedora/linux/releases/$releasever/Everything/$basearch/os/
repo --name=fedora-updates --baseurl=https://download.fedoraproject.org/pub/fedora/linux/updates/$releasever/Everything/$basearch/

repo --name=mevya-danklinux --baseurl=https://download.copr.fedorainfracloud.org/results/avengemedia/danklinux/fedora-$releasever-$basearch/
repo --name=mevya-dms --baseurl=https://download.copr.fedorainfracloud.org/results/avengemedia/dms/fedora-$releasever-$basearch/
repo --name=mevya-nautilus-terminal --baseurl=https://download.copr.fedorainfracloud.org/results/monkeygold/nautilus-open-any-terminal/fedora-$releasever-$basearch/
repo --name=rpmfusion-free --baseurl=https://download1.rpmfusion.org/free/fedora/releases/$releasever/Everything/$basearch/os/
repo --name=rpmfusion-free-updates --baseurl=https://download1.rpmfusion.org/free/fedora/updates/$releasever/$basearch/
repo --name=rpmfusion-nonfree --baseurl=https://download1.rpmfusion.org/nonfree/fedora/releases/$releasever/Everything/$basearch/os/
repo --name=rpmfusion-nonfree-updates --baseurl=https://download1.rpmfusion.org/nonfree/fedora/updates/$releasever/$basearch/

%packages
__MEVYA_PACKAGES__
%end

%post --nochroot --log=/root/mevya-ks-post-nochroot.log
set -eux

# Anaconda runs the regular %post inside the target chroot. Copy the
# installer resolver there so network operations such as COPR registration
# and Flathub setup can resolve external hosts during the compose.
if [ -r /etc/resolv.conf ]; then
    mkdir -p /mnt/sysroot/etc
    rm -f /mnt/sysroot/etc/resolv.conf
    cp -L /etc/resolv.conf /mnt/sysroot/etc/resolv.conf
fi
%end

%post --erroronfail --log=/root/mevya-ks-post.log
set -eux

# Install Mevya's runtime files before any optional post-install step can
# abort the script.  In particular, dnf5 COPR setup may not have working DNS
# yet during Anaconda's post-install phase.
__MEVYA_CONFIG_POST__

# Compile the system dconf defaults so GTK/libadwaita applications, including
# Nautilus, follow the dark desktop preference in the live and installed image.
dconf update

# Keep the live session in the same graphical path as the installed system.
systemctl set-default graphical.target
systemctl enable greetd.service
systemctl enable mevya-firstboot.service
systemctl enable power-profiles-daemon.service
systemctl enable systemd-oomd.service
systemctl enable firewalld.service
systemctl enable chronyd.service
systemctl enable cups.socket
systemctl enable fwupd-refresh.timer || true

# Use the unrestricted Flathub remote for Flatpak applications. Network/DNS
# is not guaranteed during Anaconda's chrooted %post, so this is best effort;
# mevya-firstboot retries it once the installed system has networking.
if timeout 30s flatpak remote-add --system --if-not-exists flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo; then
    printf '%s\n' 'Flathub system remote configured during image build.'
else
    printf '%s\n' 'WARNING: Flathub unavailable during image build; first boot will retry.' >&2
fi
flatpak remote-delete --system fedora || true

# Register the Mevya Plymouth theme for the live system and its initramfs.
plymouth-set-default-theme mevya
dracut --regenerate-all --force

# Keep the external repositories required by selected desktop packages
# available for normal DNF updates after installation.
# These COPRs provide packages listed in the live manifest. Keep failures
# fatal: silently skipping one would leave the installed system without DMS,
# the DankLinux integration, or Nautilus' terminal integration. Retry transient
# DNS/network failures before failing the compose.
retry_copr_enable() {
    local repo="$1"
    local attempt
    for attempt in 1 2 3; do
        if dnf5 -y copr enable "${repo}"; then
            return 0
        fi
        sleep 5
    done
    return 1
}
retry_copr_enable avengemedia/danklinux
retry_copr_enable avengemedia/dms
retry_copr_enable monkeygold/nautilus-open-any-terminal

# Brand both the installed system and the generated boot-loader titles.
os_release=/usr/lib/os-release
mevya_version=$(sed -n 's/^VERSION_ID=//p' "${os_release}" | tr -d '"')
: "${mevya_version:=44}"
sed -i 's/^NAME=.*/NAME="Mevya"/' "${os_release}"
sed -i 's/^ID=.*/ID=mevya/' "${os_release}"
if grep -q '^ID_LIKE=' "${os_release}"; then
    sed -i 's/^ID_LIKE=.*/ID_LIKE=fedora/' "${os_release}"
else
    printf '%s\n' 'ID_LIKE=fedora' >> "${os_release}"
fi
sed -i "s/^PRETTY_NAME=.*/PRETTY_NAME=\"Mevya ${mevya_version}\"/" "${os_release}"
sed -i "s/^VERSION_ID=.*/VERSION_ID=\"${mevya_version}\"/" "${os_release}"
sed -i "s/^VERSION=.*/VERSION=\"Mevya ${mevya_version}\"/" "${os_release}"
sed -i 's/^VARIANT=.*/VARIANT="Mevya"/' "${os_release}"
if grep -q '^VARIANT_ID=' "${os_release}"; then
    sed -i 's/^VARIANT_ID=.*/VARIANT_ID=mevya/' "${os_release}"
else
    printf '%s\n' 'VARIANT_ID=mevya' >> "${os_release}"
fi
grub_config=/etc/default/grub
mkdir -p "$(dirname "${grub_config}")"
if grep -q '^GRUB_DISTRIBUTOR=' "${grub_config}" 2>/dev/null; then
    sed -i "s|^GRUB_DISTRIBUTOR=.*|GRUB_DISTRIBUTOR=\"Mevya ${mevya_version}\"|" "${grub_config}"
else
    printf 'GRUB_DISTRIBUTOR="Mevya %s"\n' "${mevya_version}" >> "${grub_config}"
fi

%end
